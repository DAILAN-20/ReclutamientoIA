@model ReclutamientoIA.Models.ConfiguracionIAViewModel

@{
    ViewData["Title"] = "Configuración de IA";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-1">
                        Configuración de Inteligencia Artificial
                    </h4>

                    <p class="mb-0 small">
                        Configure el proveedor, modelo y clave API.
                    </p>
                </div>

                <div class="card-body p-4">

                    @if (TempData["Exito"] != null)
                    {
                        <div class="alert alert-success
                            alert-dismissible fade show">

                            @TempData["Exito"]

                            <button type="button"
                                    class="btn-close"
                                    data-bs-dismiss="alert"
                                    aria-label="Cerrar">
                            </button>
                        </div>
                    }

                    <form asp-controller="ConfiguracionSistema"
                          asp-action="InteligenciaArtificial"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input asp-for="IdConfiguracion"
                               type="hidden" />

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div asp-validation-summary="ModelOnly"
                                 class="alert alert-danger">
                            </div>
                        }

                        <!-- PROVEEDOR -->
                        <div class="mb-3">

                            <label asp-for="Proveedor"
                                   class="form-label fw-semibold">
                                Proveedor de IA
                            </label>

                            <select asp-for="Proveedor"
                                    id="proveedor"
                                    class="form-select">

                                <option value="OpenAI">
                                    OpenAI
                                </option>

                                <option value="Gemini">
                                    Gemini / Google
                                </option>

                            </select>

                            <span asp-validation-for="Proveedor"
                                  class="text-danger">
                            </span>
                        </div>

                        <!-- MODELO -->
                        <div class="mb-3">

                            <label asp-for="Modelo"
                                   class="form-label fw-semibold">
                                Modelo
                            </label>

                            <select asp-for="Modelo"
                                    id="modelo"
                                    class="form-select"
                                    data-modelo-actual="@Model.Modelo">
                            </select>

                            <span asp-validation-for="Modelo"
                                  class="text-danger">
                            </span>

                            <div class="form-text">
                                Los modelos disponibles dependen
                                del proveedor seleccionado.
                            </div>
                        </div>

                        <!-- CLAVE API -->
                        <div class="mb-4">

                            <label for="ClaveApi"
                                   class="form-label fw-semibold">
                                Clave API
                            </label>

                            <div class="input-group">

                                <input id="ClaveApi"
                                       name="ClaveApi"
                                       type="password"
                                       class="form-control"
                                       autocomplete="off"
                                       placeholder="Ingrese la clave API" />

                                <button type="button"
                                        id="botonMostrarClave"
                                        class="btn btn-outline-secondary">
                                    Mostrar
                                </button>

                            </div>

                            <span asp-validation-for="ClaveApi"
                                  class="text-danger">
                            </span>

                            @if (Model.TieneClaveGuardada)
                            {
                                <div class="form-text text-success">
                                    Ya existe una clave guardada.
                                    Déjela vacía para conservarla.
                                </div>
                            }
                            else
                            {
                                <div class="form-text">
                                    Todavía no existe una clave
                                    API guardada.
                                </div>
                            }

                        </div>

                        <!-- BOTONES -->
                        <div class="d-flex justify-content-end gap-2">

                            <a asp-controller="Home"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                Cancelar
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                Guardar configuración
                            </button>

                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        const proveedor =
            document.getElementById("proveedor");

        const selectorModelo =
            document.getElementById("modelo");

        const claveApi =
            document.getElementById("ClaveApi");

        const botonMostrarClave =
            document.getElementById(
                "botonMostrarClave"
            );

        const modeloGuardado =
            selectorModelo.dataset.modeloActual;

        const modelosPorProveedor = {
            OpenAI: [
                {
                    valor: "gpt-5-mini",
                    texto: "GPT-5 Mini"
                },
                {
                    valor: "gpt-5",
                    texto: "GPT-5"
                },
                {
                    valor: "gpt-4.1-mini",
                    texto: "GPT-4.1 Mini"
                }
            ],

            Gemini: [
                {
                    valor: "gemini-2.5-flash",
                    texto: "Gemini 2.5 Flash"
                },
                {
                    valor: "gemini-2.5-pro",
                    texto: "Gemini 2.5 Pro"
                }
            ]
        };

        function cargarModelos(
            conservarSeleccion
        ) {
            const proveedorSeleccionado =
                proveedor.value;

            const modelosDisponibles =
                modelosPorProveedor[
                proveedorSeleccionado
                ] || [];

            selectorModelo.innerHTML = "";

            modelosDisponibles.forEach(
                modelo => {
                    const opcion =
                        document.createElement(
                            "option"
                        );

                    opcion.value =
                        modelo.valor;

                    opcion.textContent =
                        modelo.texto;

                    if (
                        conservarSeleccion &&
                        modelo.valor ===
                        modeloGuardado
                    ) {
                        opcion.selected = true;
                    }

                    selectorModelo.appendChild(
                        opcion
                    );
                }
            );
        }

        proveedor.addEventListener(
            "change",
            function() {
                cargarModelos(false);
            }
        );

        botonMostrarClave.addEventListener(
            "click",
            function() {
                const claveEstaOculta =
                    claveApi.type ===
                    "password";

                claveApi.type =
                    claveEstaOculta
                        ? "text"
                        : "password";

                botonMostrarClave.textContent =
                    claveEstaOculta
                        ? "Ocultar"
                        : "Mostrar";
            }
        );

        cargarModelos(true);
    </script>
}