@model ReclutamientoIA.Models.SubirCandidatoViewModel

@{
    ViewData["Title"] = "Subir currículum";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/candidatos.css"
          asp-append-version="true" />
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Registrar candidato</h4>
            </div>

            <div class="card-body">
                <form asp-action="Create"
                      method="post"
                      enctype="multipart/form-data">

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="NombreCompleto"
                               class="form-label"></label>
                        <input asp-for="NombreCompleto"
                               class="form-control"
                               placeholder="Opcional" />
                        <span asp-validation-for="NombreCompleto"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Correo"
                               class="form-label"></label>
                        <input asp-for="Correo"
                               class="form-control"
                               placeholder="Opcional" />
                        <span asp-validation-for="Correo"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Telefono"
                               class="form-label"></label>
                        <input asp-for="Telefono"
                               class="form-control"
                               placeholder="Opcional" />
                        <span asp-validation-for="Telefono"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ArchivoCv"
                               class="form-label">
                            Currículum en PDF
                        </label>

                        <input asp-for="ArchivoCv"
                               type="file"
                               class="form-control"
                               accept=".pdf,application/pdf" />

                        <div class="form-text">
                            Solo archivos PDF de hasta 10 MB.
                        </div>

                        <span asp-validation-for="ArchivoCv"
                              class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit"
                                class="btn btn-primary">
                            Guardar candidato
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Volver
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}