@model IEnumerable<ReclutamientoIA.Models.Candidato>

@{
    ViewData["Title"] = "Candidatos";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/candidatos.css"
          asp-append-version="true" />
}

<div class="d-flex justify-content-between
    align-items-center flex-wrap gap-3 mb-4">
    <div>
        <h1>Candidatos</h1>

        <p class="text-muted mb-0">
            Banco general de currículums
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        Subir currículum
    </a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">
        @TempData["Error"]
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        Todavía no hay candidatos registrados.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Candidato</th>
                    <th>Correo</th>
                    <th>Teléfono</th>
                    <th>Currículum</th>
                    <th>Tamaño</th>
                    <th>Registro</th>
                    <th>Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var candidato in Model)
                {
                    <tr>
                        <td>
                            @(candidato.NombreCompleto
                                ?? "Pendiente de extracción")
                        </td>

                        <td class="text-break">
                            @(candidato.Correo
                                ?? "No disponible")
                        </td>

                        <td>
                            @(candidato.Telefono
                                ?? "No disponible")
                        </td>

                        <td>
                            @candidato.NombreArchivoOriginal
                        </td>

                        <td>
                            @((candidato.TamanoArchivo / 1024.0)
                                .ToString("N1")) KB
                        </td>

                        <td>
                            @candidato.FechaRegistro.ToString(
                                "dd/MM/yyyy hh:mm tt"
                            )
                        </td>

                        <td>
                            @if (candidato.Activo)
                            {
                                <span class="badge bg-success">
                                    Activo
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    Inactivo
                                </span>
                            }
                        </td>

                        <td>
                            <div class="d-flex justify-content-center
                                flex-wrap gap-2">

                                <a asp-controller="Candidatos"
                                   asp-action="VerCurriculum"
                                   asp-route-id="@candidato.IdCandidato"
                                   target="_blank"
                                   class="btn btn-outline-success btn-sm">
                                    Ver CV
                                </a>

                                <a asp-controller="Candidatos"
                                   asp-action="Descargar"
                                   asp-route-id="@candidato.IdCandidato"
                                   class="btn btn-outline-primary btn-sm">
                                    Descargar
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}