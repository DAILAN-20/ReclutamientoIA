@model IEnumerable<ReclutamientoIA.Models.Candidato>

@{
    ViewData["Title"] =
        "Currículums recibidos por correo";
    var idsCurriculumsCorreo =
ViewBag.IdsCurriculumsCorreo as List<int>
?? new List<int>();
}

@section Styles {
    <style>
        .correo-card {
            border: 0;
            border-radius: 14px;
            box-shadow: 0 4px 16px
                rgba(0, 0, 0, 0.07);
        }

        .correo-tabla {
            min-width: 1050px;
        }

        .correo-tabla th {
            white-space: nowrap;
        }

        .correo-tabla td,
        .correo-tabla th {
            padding: 14px;
            vertical-align: middle;
        }

        .asunto-correo {
            max-width: 280px;
            overflow-wrap: anywhere;
        }

        .archivo-correo {
            max-width: 220px;
            overflow-wrap: anywhere;
        }
    </style>
}

<div class="d-flex justify-content-between
    align-items-center flex-wrap gap-3 mb-4">

    <div>
        <h1>Currículums recibidos por correo</h1>

        <p class="text-muted mb-0">
            Extraiga y administre los currículums PDF
            enviados a Gmail.
        </p>
    </div>

    <form asp-action="Importar"
          method="post"
          id="formImportar">

        <button type="submit"
                class="btn btn-primary btn-lg"
                id="botonImportar">
            Revisar correo
        </button>
    </form>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">
        @TempData["Error"]
    </div>
}
<div class="card correo-card mb-4">
    <div class="card-body p-4">
        <h2 class="h4 fw-bold mb-3">
            Analizar currículums por vacante
        </h2>

        <p class="text-muted">
            Seleccione una vacante para analizar todos los
            currículums sincronizados desde el correo.
        </p>

        @if (idsCurriculumsCorreo.Any())
        {
            <form asp-controller="Vacantes"
                  asp-action="SeleccionarCandidatos"
                  method="post"
                  id="formAnalizarCorreo">

                @foreach (var idCandidato
                    in idsCurriculumsCorreo)
                {
                    <input type="hidden"
                           name="CandidatosSeleccionados"
                           value="@idCandidato" />
                }

                <div class="mb-3">
                    <label for="idVacanteCorreo"
                           class="form-label fw-semibold">
                        Seleccione una vacante
                    </label>

                    <select id="idVacanteCorreo"
                            name="IdVacante"
                            asp-items="ViewBag.Vacantes"
                            class="form-select form-select-lg"
                            required>

                        <option value="">
                            Seleccione una vacante
                        </option>
                    </select>
                </div>

                <div class="alert alert-info">
                    Currículums disponibles:
                    <strong>
                        @idsCurriculumsCorreo.Count
                    </strong>
                </div>

                <button type="submit"
                        class="btn btn-success btn-lg"
                        id="botonAnalizarCorreo">
                    Analizar todos con IA
                </button>
            </form>
        }
        else
        {
            <div class="alert alert-warning mb-0">
                Primero debe sincronizar currículums
                desde el correo.
            </div>
        }
    </div>
</div>

<div id="avisoImportando"
     class="alert alert-info d-none">

    <div class="d-flex align-items-center gap-3">
        <div class="spinner-border spinner-border-sm"
             role="status"></div>

        <div>
            <strong>Revisando el correo…</strong>

            <div>
                No cierre ni actualice esta página.
            </div>
        </div>
    </div>
</div>

<div class="card correo-card mb-4">
    <div class="card-body">
        <form asp-action="Index"
              method="get"
              class="row g-2">

            <div class="col-md-9">
                <input type="search"
                       name="buscar"
                       value="@ViewBag.Buscar"
                       class="form-control"
                       placeholder="Buscar por nombre, correo, asunto o archivo" />
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit"
                        class="btn btn-primary">
                    Buscar
                </button>

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Limpiar
                </a>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No hay currículums importados desde el correo.

        Pulse <strong>Revisar correo</strong> para buscar
        archivos PDF en la bandeja de entrada.
    </div>
}
else
{
    <div class="table-responsive correo-card">
        <table class="table table-hover
            align-middle mb-0 correo-tabla">

            <thead class="table-dark">
                <tr>
                    <th>Nombre</th>
                    <th>Correo remitente</th>
                    <th>Asunto</th>
                    <th>Fecha del correo</th>
                    <th>Archivo</th>
                    <th>Tamaño</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var candidato in Model)
                {
                    var tamanoKb =
                        candidato.TamanoArchivo / 1024.0;

                    <tr>
                        <td>
                            @(candidato.NombreCompleto
                                ?? "Pendiente de extracción")
                        </td>

                        <td class="text-break">
                            @(candidato.Correo
                                ?? "No disponible")
                        </td>

                        <td class="asunto-correo">
                            @(candidato.AsuntoCorreo
                                ?? "Sin asunto")
                        </td>

                        <td>
                            @if (candidato.FechaCorreo.HasValue)
                            {
                                @(
                                    candidato.FechaCorreo.Value
                                        .ToLocalTime()
                                        .ToString("dd/MM/yyyy HH:mm")
                                )
                            }
                            else
                            {
                                <span class="text-muted">
                                    No disponible
                                </span>
                            }
                        </td>

                        <td class="archivo-correo">
                            @candidato.NombreArchivoOriginal
                        </td>

                        <td>
                            @tamanoKb.ToString("N0") KB
                        </td>

                        <td class="text-center">
                            <a asp-controller="Candidatos"
                               asp-action="Descargar"
                               asp-route-id="@candidato.IdCandidato"
                               class="btn btn-outline-primary btn-sm">
                                Descargar CV
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
        (() => {
            const formulario =
                document.getElementById("formImportar");

            const boton =
                document.getElementById("botonImportar");

            const aviso =
                document.getElementById("avisoImportando");

            formulario.addEventListener("submit", () => {
                boton.disabled = true;
                boton.textContent = "Revisando…";
                aviso.classList.remove("d-none");
            });
        })();
    </script>

    <script>
        (() => {
            const formulario = document.getElementById(
                "formAnalizarCorreo"
            );

            if (!formulario) {
                return;
            }

            const boton = document.getElementById(
                "botonAnalizarCorreo"
            );

            formulario.addEventListener("submit", () => {
                if (!formulario.checkValidity()) {
                    return;
                }

                boton.disabled = true;
                boton.textContent =
                    "Analizando currículums…";
            });
        })();
    </script>
}