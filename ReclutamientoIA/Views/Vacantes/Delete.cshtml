@model ReclutamientoIA.Models.Vacante

@{
    ViewData["Title"] = "Eliminar vacante";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">Eliminar vacante</h4>
            </div>

            <div class="card-body">
                <div class="alert alert-warning">
                    ¿Está seguro de que desea eliminar esta vacante?
                    Esta acción no se puede deshacer.
                </div>

                <dl class="row">
                    <dt class="col-sm-4">Título</dt>
                    <dd class="col-sm-8">@Model.Titulo</dd>

                    <dt class="col-sm-4">Descripción</dt>
                    <dd class="col-sm-8">@Model.Descripcion</dd>

                    <dt class="col-sm-4">Estado</dt>
                    <dd class="col-sm-8">@Model.Estado</dd>

                    <dt class="col-sm-4">Fecha de creación</dt>
                    <dd class="col-sm-8">
                        @Model.FechaCreacion.ToString("dd/MM/yyyy")
                    </dd>
                </dl>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="IdVacante" />

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger">
                            Sí, eliminar
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>