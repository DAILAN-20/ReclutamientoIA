@model IEnumerable<ReclutamientoIA.Models.Vacante>

@{
    ViewData["Title"] = "Vacantes";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/vacantes.css"
          asp-append-version="true" />
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Vacantes</h1>

        <p class="text-muted">
            Administración de vacantes disponibles
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-primary">
        Crear vacante
    </a>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success">
        @TempData["Mensaje"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        Todavía no hay vacantes registradas.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">

            <thead class="table-dark">
                <tr>
                    <th>Título</th>
                    <th>Descripción</th>
                    <th>Requisitos</th>
                    <th>Estado</th>
                    <th>Fecha de creación</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var vacante in Model)
                {
                    <tr>
                        <td>
                            <strong>
                                @vacante.Titulo
                            </strong>
                        </td>

                        <td>
                            @vacante.Descripcion
                        </td>

                        <td>
                            @vacante.Requisitos
                        </td>

                        <td>
                            @if (vacante.Estado == "Activa" ||
                                 vacante.Estado == "Activo")
                            {
                                <span class="badge bg-success">
                                    @vacante.Estado
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @vacante.Estado
                                </span>
                            }
                        </td>

                        <td>
                            @vacante.FechaCreacion.ToString("dd/MM/yyyy")
                        </td>

                        <td>
                            <div class="d-flex justify-content-center flex-wrap gap-2">

                                <a asp-action="Details"
                                   asp-route-idVacante="@vacante.IdVacante"
                                   class="btn btn-sm btn-info text-white">
                                    Ver
                                </a>

                                <a asp-action="Edit"
                                   asp-route-idVacante="@vacante.IdVacante"
                                   class="btn btn-sm btn-warning">
                                    Editar
                                </a>

                                <a asp-action="Delete"
                                   asp-route-idVacante="@vacante.IdVacante"
                                   class="btn btn-sm btn-danger">
                                    Eliminar
                                </a>

                            </div>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
}