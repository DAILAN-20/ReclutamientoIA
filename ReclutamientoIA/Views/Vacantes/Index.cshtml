@model IEnumerable<ReclutamientoIA.Models.Vacante>

@{
    ViewData["Title"] = "Vacantes";
    var vacantesActivas = Model.Count(v => v.Estado == "Activa");
    var vacantesCerradas = Model.Count(v => v.Estado == "Cerrada" || v.Estado == "Inactiva");
}

@section Styles {
    <link rel="stylesheet" href="~/css/vacantes.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
}

<style>
    /* ============================================
           VACANTES - ESTILOS PROFESIONALES
           ============================================ */

    .page-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 20px;
        padding: 30px 35px;
        margin-bottom: 30px;
        color: white;
        box-shadow: 0 10px 40px rgba(102, 126, 234, 0.3);
        position: relative;
        overflow: hidden;
    }

        .page-header::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -10%;
            width: 300px;
            height: 300px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 50%;
        }

        .page-header::after {
            content: '';
            position: absolute;
            bottom: -40%;
            left: 20%;
            width: 200px;
            height: 200px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 50%;
        }

        .page-header h1 {
            font-size: 28px;
            font-weight: 700;
            margin: 0 0 5px;
            position: relative;
            z-index: 1;
        }

            .page-header h1 i {
                margin-right: 12px;
            }

        .page-header .subtitle {
            opacity: 0.9;
            font-size: 15px;
            margin: 0;
            position: relative;
            z-index: 1;
        }

    .header-actions {
        position: relative;
        z-index: 1;
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 15px;
    }

    .btn-header {
        background: rgba(255, 255, 255, 0.2);
        color: white;
        border: 2px solid rgba(255, 255, 255, 0.3);
        padding: 10px 24px;
        border-radius: 12px;
        font-weight: 600;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        backdrop-filter: blur(10px);
    }

        .btn-header:hover {
            background: rgba(255, 255, 255, 0.3);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
        }

    .btn-header-primary {
        background: white;
        color: #667eea;
        border-color: white;
    }

        .btn-header-primary:hover {
            background: white;
            color: #667eea;
            transform: translateY(-2px) scale(1.02);
        }

    /* ====== MÉTRICAS ====== */
    .metrics-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .metric-card {
        background: white;
        border-radius: 16px;
        padding: 22px 25px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
        display: flex;
        align-items: center;
        gap: 18px;
        transition: all 0.3s ease;
        border: 1px solid rgba(0, 0, 0, 0.04);
    }

        .metric-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.1);
        }

    .metric-icon {
        width: 50px;
        height: 50px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        flex-shrink: 0;
    }

        .metric-icon.purple {
            background: #e8eaf6;
            color: #5c6bc0;
        }

        .metric-icon.green {
            background: #e8f5e9;
            color: #43a047;
        }

        .metric-icon.orange {
            background: #fff3e0;
            color: #fb8c00;
        }

        .metric-icon.blue {
            background: #e3f2fd;
            color: #1e88e5;
        }

    .metric-info h3 {
        font-size: 13px;
        color: #78909c;
        margin: 0 0 4px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .metric-info .number {
        font-size: 26px;
        font-weight: 700;
        color: #263238;
        line-height: 1.2;
    }

    .metric-info .trend {
        font-size: 12px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        margin-top: 4px;
        font-weight: 500;
    }

    .trend.up {
        color: #43a047;
    }

    .trend.down {
        color: #e53935;
    }

    /* ====== FILTROS ====== */
    .filters-bar {
        background: white;
        border-radius: 16px;
        padding: 18px 22px;
        margin-bottom: 25px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 15px;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
        border: 1px solid rgba(0, 0, 0, 0.04);
    }

        .filters-bar .search-box {
            flex: 1;
            min-width: 200px;
            position: relative;
        }

            .filters-bar .search-box input {
                width: 100%;
                padding: 10px 16px 10px 42px;
                border: 2px solid #e8edf2;
                border-radius: 10px;
                font-size: 14px;
                transition: all 0.3s ease;
                background: #f8fafc;
            }

                .filters-bar .search-box input:focus {
                    border-color: #667eea;
                    box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
                    outline: none;
                    background: white;
                }

            .filters-bar .search-box i {
                position: absolute;
                left: 14px;
                top: 50%;
                transform: translateY(-50%);
                color: #90a4ae;
            }

        .filters-bar .filter-group {
            display: flex;
            gap: 10px;
            flex-wrap: wrap;
        }

        .filters-bar select {
            padding: 10px 16px;
            border: 2px solid #e8edf2;
            border-radius: 10px;
            background: #f8fafc;
            font-size: 14px;
            color: #263238;
            cursor: pointer;
            transition: all 0.3s ease;
            min-width: 140px;
        }

            .filters-bar select:focus {
                border-color: #667eea;
                box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
                outline: none;
                background: white;
            }

    /* ====== TABLA ====== */
    .table-container {
        background: white;
        border-radius: 16px;
        padding: 0;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
        border: 1px solid rgba(0, 0, 0, 0.04);
        overflow: hidden;
    }

    .table {
        margin: 0;
        font-size: 14px;
    }

        .table thead th {
            background: #f8fafc;
            color: #546e7a;
            font-weight: 600;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 16px 20px;
            border-bottom: 2px solid #e8edf2;
            white-space: nowrap;
        }

        .table tbody td {
            padding: 16px 20px;
            vertical-align: middle;
            border-bottom: 1px solid #f0f2f5;
            color: #37474f;
        }

        .table tbody tr {
            transition: background 0.2s ease;
        }

            .table tbody tr:hover {
                background: #f8faff;
            }

            .table tbody tr:last-child td {
                border-bottom: none;
            }

    .badge-status {
        padding: 6px 14px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 12px;
        letter-spacing: 0.3px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .badge-status.active {
            background: #e8f5e9;
            color: #2e7d32;
        }

            .badge-status.active::before {
                content: '';
                width: 6px;
                height: 6px;
                background: #43a047;
                border-radius: 50%;
                display: inline-block;
                animation: pulse-dot 1.5s infinite;
            }

    @@keyframes pulse-dot {
        0%, 100% {
            opacity: 1;
            transform: scale(1);
        }

        50% {
            opacity: 0.5;
            transform: scale(0.8);
        }
    }

    .badge-status.closed {
        background: #f5f5f5;
        color: #78909c;
    }

    .badge-status.draft {
        background: #fff3e0;
        color: #e65100;
    }

    .truncate-text {
        max-width: 180px;
        display: inline-block;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .btn-actions {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        justify-content: center;
    }

        .btn-actions .btn {
            padding: 6px 12px;
            font-size: 12px;
            border-radius: 8px;
            font-weight: 500;
            transition: all 0.2s ease;
            border: none;
        }

            .btn-actions .btn i {
                margin-right: 4px;
            }

        .btn-actions .btn-view {
            background: #e3f2fd;
            color: #1565c0;
        }

            .btn-actions .btn-view:hover {
                background: #1e88e5;
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(30, 136, 229, 0.3);
            }

        .btn-actions .btn-edit {
            background: #fff3e0;
            color: #e65100;
        }

            .btn-actions .btn-edit:hover {
                background: #fb8c00;
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(251, 140, 0, 0.3);
            }

        .btn-actions .btn-delete {
            background: #ffebee;
            color: #c62828;
        }

            .btn-actions .btn-delete:hover {
                background: #e53935;
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(229, 57, 53, 0.3);
            }

        .btn-actions .btn-analizar {
            background: #e8eaf6;
            color: #3f51b5;
        }

            .btn-actions .btn-analizar:hover {
                background: #3f51b5;
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(63, 81, 181, 0.3);
            }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
    }

        .empty-state i {
            font-size: 64px;
            color: #cfd8dc;
            margin-bottom: 20px;
            display: block;
        }

        .empty-state h4 {
            color: #455a64;
            margin-bottom: 10px;
        }

        .empty-state p {
            color: #90a4ae;
        }

    /* ====== ALERTAS ====== */
    .custom-alert {
        border-radius: 12px;
        padding: 16px 20px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        border: none;
        font-weight: 500;
    }

        .custom-alert i {
            font-size: 20px;
        }

        .custom-alert.alert-success {
            background: #e8f5e9;
            color: #2e7d32;
            border-left: 4px solid #43a047;
        }

        .custom-alert.alert-warning {
            background: #fff3e0;
            color: #e65100;
            border-left: 4px solid #fb8c00;
        }

        .custom-alert.alert-info {
            background: #e3f2fd;
            color: #1565c0;
            border-left: 4px solid #1e88e5;
        }

    /* ====== RESPONSIVE ====== */
    @@media (max-width: 768px) {
        .page-header {
            padding: 20px;
        }

            .page-header h1 {
                font-size: 22px;
            }

        .metrics-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
        }

        .metric-card {
            padding: 16px 18px;
        }

        .metric-info .number {
            font-size: 20px;
        }

        .filters-bar {
            flex-direction: column;
            align-items: stretch;
        }

            .filters-bar .search-box {
                min-width: unset;
            }

            .filters-bar .filter-group {
                flex-wrap: wrap;
            }

            .filters-bar select {
                flex: 1;
                min-width: unset;
            }

        .table thead th {
            font-size: 11px;
            padding: 12px 14px;
        }

        .table tbody td {
            padding: 12px 14px;
            font-size: 13px;
        }

        .truncate-text {
            max-width: 100px;
        }

        .btn-actions .btn {
            padding: 4px 10px;
            font-size: 11px;
        }

            .btn-actions .btn span {
                display: none;
            }

            .btn-actions .btn i {
                margin-right: 0;
            }
    }

    @@media (max-width: 480px) {
        .metrics-grid {
            grid-template-columns: 1fr;
        }

        .header-actions {
            flex-direction: column;
        }

        .btn-header {
            justify-content: center;
        }
    }
</style>

<div class="container-fluid px-0">

    <!-- ====== HEADER ====== -->
    <div class="page-header">
        <h1>
            <i class="fas fa-briefcase"></i> Vacantes
        </h1>
        <p class="subtitle">
            <i class="fas fa-database me-1"></i>
            Administración de puestos disponibles y su estado actual
        </p>
        <div class="header-actions">
            <a asp-action="Create" class="btn-header btn-header-primary">
                <i class="fas fa-plus-circle"></i> Crear Vacante
            </a>
            <a href="#" class="btn-header" onclick="window.print()">
                <i class="fas fa-print"></i> Imprimir
            </a>
            <a href="#" class="btn-header">
                <i class="fas fa-file-export"></i> Exportar
            </a>
        </div>
    </div>

    <!-- ====== MÉTRICAS ====== -->
    <div class="metrics-grid">
        <div class="metric-card">
            <div class="metric-icon purple">
                <i class="fas fa-briefcase"></i>
            </div>
            <div class="metric-info">
                <h3>Total Vacantes</h3>
                <div class="number">@Model.Count()</div>
                <span class="trend up">
                    <i class="fas fa-arrow-up"></i> +12% este mes
                </span>
            </div>
        </div>

        <div class="metric-card">
            <div class="metric-icon green">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="metric-info">
                <h3>Vacantes Activas</h3>
                <div class="number">@vacantesActivas</div>
                <span class="trend up">
                    <i class="fas fa-arrow-up"></i> +8% este mes
                </span>
            </div>
        </div>

        <div class="metric-card">
            <div class="metric-icon orange">
                <i class="fas fa-clock"></i>
            </div>
            <div class="metric-info">
                <h3>En Proceso</h3>
                <div class="number">@(Model.Count(v => v.Estado == "En proceso" || v.Estado == "Proceso"))</div>
                <span class="trend down">
                    <i class="fas fa-arrow-down"></i> -3% este mes
                </span>
            </div>
        </div>

        <div class="metric-card">
            <div class="metric-icon blue">
                <i class="fas fa-user-check"></i>
            </div>
            <div class="metric-info">
                <h3>Contrataciones</h3>
                <div class="number">@vacantesCerradas</div>
                <span class="trend up">
                    <i class="fas fa-arrow-up"></i> +15% este mes
                </span>
            </div>
        </div>
    </div>

    <!-- ====== ALERTAS ====== -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="custom-alert alert-success">
            <i class="fas fa-check-circle"></i>
            @TempData["Mensaje"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="custom-alert alert-warning">
            <i class="fas fa-exclamation-triangle"></i>
            @TempData["Error"]
        </div>
    }

    <!-- ====== FILTROS ====== -->
    <div class="filters-bar">
        <div class="search-box">
            <i class="fas fa-search"></i>
            <input type="text" id="searchInput" placeholder="Buscar vacantes por título, descripción..." />
        </div>
        <div class="filter-group">
            <select id="statusFilter">
                <option value="">Todos los estados</option>
                <option value="Activa">Activas</option>
                <option value="En proceso">En Proceso</option>
                <option value="Cerrada">Cerradas</option>
                <option value="Inactiva">Inactivas</option>
            </select>
            <select id="sortFilter">
                <option value="newest">Más recientes</option>
                <option value="oldest">Más antiguas</option>
                <option value="title">Por título</option>
            </select>
        </div>
    </div>

    <!-- ====== TABLA ====== -->
    <div class="table-container">
        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="fas fa-inbox"></i>
                <h4>No hay vacantes registradas</h4>
                <p>Comienza creando tu primera vacante para atraer talento.</p>
                <a asp-action="Create" class="btn btn-primary mt-3">
                    <i class="fas fa-plus-circle me-2"></i> Crear Vacante
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table" id="vacantesTable">
                    <thead>
                        <tr>
                            <th style="width: 20%">
                                <i class="fas fa-tag me-1"></i> Título
                            </th>
                            <th style="width: 20%">
                                <i class="fas fa-align-left me-1"></i> Descripción
                            </th>
                            <th style="width: 18%">
                                <i class="fas fa-list-check me-1"></i> Requisitos
                            </th>
                            <th style="width: 12%">
                                <i class="fas fa-circle me-1"></i> Estado
                            </th>
                            <th style="width: 12%">
                                <i class="fas fa-calendar me-1"></i> Fecha
                            </th>
                            <th style="width: 18%" class="text-center">
                                <i class="fas fa-cog me-1"></i> Acciones
                            </th>
                        </tr>
                    </thead>
                    <tbody id="tableBody">
                        @foreach (var vacante in Model)
                        {
                            <tr data-status="@vacante.Estado">
                                <td>
                                    <strong>@vacante.Titulo</strong>
                                </td>
                                <td>
                                    <span class="truncate-text" title="@vacante.Descripcion">
                                        @vacante.Descripcion
                                    </span>
                                </td>
                                <td>
                                    <span class="truncate-text" title="@vacante.Requisitos">
                                        @vacante.Requisitos
                                    </span>
                                </td>
                                <td>
                                    @{
                                        var estadoClass = vacante.Estado == "Activa" ? "active" :
                                                         vacante.Estado == "Cerrada" || vacante.Estado == "Inactiva" ? "closed" : "draft";
                                    }
                                    <span class="badge-status @estadoClass">
                                        @vacante.Estado
                                    </span>
                                </td>
                                <td>
                                    @vacante.FechaCreacion.ToString("dd/MM/yyyy")
                                    <br />
                                    <small class="text-muted">@vacante.FechaCreacion.ToString("HH:mm")</small>
                                </td>
                                <td>
                                    <div class="btn-actions">
                                        <a asp-action="Details"
                                           asp-route-idVacante="@vacante.IdVacante"
                                           class="btn btn-view"
                                           title="Ver detalles">
                                            <i class="fas fa-eye"></i>
                                            <span>Ver</span>
                                        </a>
                                        <a asp-action="Edit"
                                           asp-route-idVacante="@vacante.IdVacante"
                                           class="btn btn-edit"
                                           title="Editar vacante">
                                            <i class="fas fa-edit"></i>
                                            <span>Editar</span>
                                        </a>
                                        <a asp-action="Delete"
                                           asp-route-idVacante="@vacante.IdVacante"
                                           class="btn btn-delete"
                                           title="Eliminar vacante"
                                           onclick="return confirm('¿Estás seguro de eliminar esta vacante?')">
                                            <i class="fas fa-trash-alt"></i>
                                            <span>Eliminar</span>
                                        </a>
                                        <a href="#"
                                           class="btn btn-analizar"
                                           title="Analizar candidatos para esta vacante"
                                           onclick="analizarVacante(@vacante.IdVacante, '@vacante.Titulo')">
                                            <i class="fas fa-robot"></i>
                                            <span>IA</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- ====== FOOTER ====== -->
    <div class="d-flex justify-content-between align-items-center mt-3 text-muted small">
        <span>
            <i class="fas fa-database me-1"></i>
            Mostrando <strong>@Model.Count()</strong> vacantes
        </span>
        <span>
            <i class="fas fa-sync-alt me-1"></i>
            Última actualización: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
        </span>
    </div>

</div>

@section Scripts {
    <script>
        // ============================================
        // FILTROS EN TIEMPO REAL
        // ============================================
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('searchInput');
            const statusFilter = document.getElementById('statusFilter');
            const sortFilter = document.getElementById('sortFilter');
            const tableBody = document.getElementById('tableBody');
            const rows = tableBody ? tableBody.querySelectorAll('tr') : [];

            function filterTable() {
                const searchTerm = searchInput.value.toLowerCase().trim();
                const statusTerm = statusFilter.value;

                let visibleRows = [];

                rows.forEach(row => {
                    const titulo = row.querySelector('td:first-child strong')?.textContent.toLowerCase() || '';
                    const descripcion = row.querySelector('td:nth-child(2)')?.textContent.toLowerCase() || '';
                    const requisitos = row.querySelector('td:nth-child(3)')?.textContent.toLowerCase() || '';
                    const estado = row.dataset.status || '';

                    const matchesSearch = titulo.includes(searchTerm) ||
                        descripcion.includes(searchTerm) ||
                        requisitos.includes(searchTerm);

                    const matchesStatus = !statusTerm || estado === statusTerm;

                    if (matchesSearch && matchesStatus) {
                        row.style.display = '';
                        visibleRows.push(row);
                    } else {
                        row.style.display = 'none';
                    }
                });

                // Actualizar contador
                const totalText = document.querySelector('.text-muted strong');
                if (totalText) {
                    totalText.textContent = visibleRows.length;
                }
            }

            // Event listeners
            searchInput?.addEventListener('input', filterTable);
            statusFilter?.addEventListener('change', filterTable);

            // Ordenar
            sortFilter?.addEventListener('change', function() {
                const sortBy = this.value;
                const rowsArray = Array.from(rows);

                rowsArray.sort((a, b) => {
                    const aTitulo = a.querySelector('td:first-child strong')?.textContent || '';
                    const bTitulo = b.querySelector('td:first-child strong')?.textContent || '';
                    const aFecha = a.querySelector('td:nth-child(5)')?.textContent.trim() || '';
                    const bFecha = b.querySelector('td:nth-child(5)')?.textContent.trim() || '';

                    if (sortBy === 'title') {
                        return aTitulo.localeCompare(bTitulo);
                    } else if (sortBy === 'newest') {
                        return bFecha.localeCompare(aFecha);
                    } else if (sortBy === 'oldest') {
                        return aFecha.localeCompare(bFecha);
                    }
                    return 0;
                });

                // Reordenar el DOM
                const tbody = document.getElementById('tableBody');
                if (tbody) {
                    rowsArray.forEach(row => tbody.appendChild(row));
                }
            });

            // Animación de entrada para las filas
            rows.forEach((row, index) => {
                row.style.opacity = '0';
                row.style.transform = 'translateY(10px)';
                setTimeout(() => {
                    row.style.transition = 'all 0.3s ease';
                    row.style.opacity = '1';
                    row.style.transform = 'translateY(0)';
                }, 50 * index);
            });
        });

        // ============================================
        // FUNCIÓN PARA ANALIZAR CON IA
        // ============================================
        function analizarVacante(id, titulo) {
            if (confirm(`¿Analizar candidatos para la vacante "${titulo}" con IA?`)) {
                window.location.href = `/Analisis/SeleccionarVacante?vacanteId=${id}`;
            }
        }

        // ============================================
        // EFECTO DE CARGA PARA LA TABLA
        // ============================================
        document.addEventListener('DOMContentLoaded', function() {
            const tableContainer = document.querySelector('.table-container');
            if (tableContainer) {
                tableContainer.style.opacity = '0';
                tableContainer.style.transform = 'translateY(20px)';
                setTimeout(() => {
                    tableContainer.style.transition = 'all 0.5s ease';
                    tableContainer.style.opacity = '1';
                    tableContainer.style.transform = 'translateY(0)';
                }, 200);
            }
        });
    </script>
}