@model IEnumerable<ReclutamientoIA.Models.Vacante>

@{
    ViewData["Title"] = "Vacantes";
    var totalVacantes = Model.Count();
    var vacantesActivas = Model.Count(v => v.Estado == "Activa" || v.Estado == "Activo");
    var vacantesInactivas = totalVacantes - vacantesActivas;
}

@section Styles {
    <link rel="stylesheet" href="~/css/vacantes.css" asp-append-version="true" />
}

<div class="vacantes-page">

    <!-- ============================================
         HEADER
         ============================================ -->
    <div class="vacantes-header">
        <div class="vacantes-header-info">
            <h1 class="vacantes-title">
                <i class="fas fa-briefcase"></i>
                Vacantes
            </h1>
            <p class="vacantes-subtitle">
                Administración de puestos disponibles y su estado actual
            </p>
        </div>

        <div class="vacantes-header-actions">
            <a asp-action="Create" class="btn-vacante-primary">
                <i class="fas fa-plus-circle"></i>
                <span>Crear vacante</span>
            </a>
        </div>
    </div>

    <!-- ============================================
         MÉTRICAS
         ============================================ -->
    <div class="vacantes-metrics">
        <div class="metric-card">
            <div class="metric-icon metric-icon-total">
                <i class="fas fa-briefcase"></i>
            </div>
            <div class="metric-info">
                <span class="metric-label">Total Vacantes</span>
                <span class="metric-value">@totalVacantes</span>
            </div>
        </div>

        <div class="metric-card">
            <div class="metric-icon metric-icon-active">
                <i class="fas fa-check-circle"></i>
            </div>
            <div class="metric-info">
                <span class="metric-label">Activas</span>
                <span class="metric-value">@vacantesActivas</span>
            </div>
        </div>

        <div class="metric-card">
            <div class="metric-icon metric-icon-inactive">
                <i class="fas fa-pause-circle"></i>
            </div>
            <div class="metric-info">
                <span class="metric-label">Inactivas</span>
                <span class="metric-value">@vacantesInactivas</span>
            </div>
        </div>
    </div>

    <!-- ============================================
         ALERTAS
         ============================================ -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert-custom alert-custom-success">
            <i class="fas fa-check-circle"></i>
            <span>@TempData["Mensaje"]</span>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert-custom alert-custom-danger">
            <i class="fas fa-exclamation-circle"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    <!-- ============================================
         CONTENIDO PRINCIPAL
         ============================================ -->
    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">
                <i class="fas fa-inbox"></i>
            </div>
            <h3 class="empty-title">No hay vacantes registradas</h3>
            <p class="empty-text">
                Comienza creando tu primera vacante para gestionar procesos de reclutamiento.
            </p>
            <a asp-action="Create" class="btn-vacante-primary">
                <i class="fas fa-plus-circle"></i>
                <span>Crear primera vacante</span>
            </a>
        </div>
    }
    else
    {
        <div class="vacantes-table-wrapper">
            <div class="table-responsive">
                <table class="vacantes-table">
                    <thead>
                        <tr>
                            <th class="col-titulo">Título</th>
                            <th class="col-descripcion">Descripción</th>
                            <th class="col-requisitos">Requisitos</th>
                            <th class="col-estado">Estado</th>
                            <th class="col-fecha">Fecha de creación</th>
                            <th class="col-acciones text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var vacante in Model)
                        {
                            var esActiva = vacante.Estado == "Activa" || vacante.Estado == "Activo";

                            <tr>
                                <td class="col-titulo">
                                    <div class="vacante-titulo">
                                        <div class="vacante-titulo-icon">
                                            <i class="fas fa-file-alt"></i>
                                        </div>
                                        <strong>@vacante.Titulo</strong>
                                    </div>
                                </td>

                                <td class="col-descripcion">
                                    <div class="text-truncate-custom" title="@vacante.Descripcion">
                                        @vacante.Descripcion
                                    </div>
                                </td>

                                <td class="col-requisitos">
                                    <div class="text-truncate-custom" title="@vacante.Requisitos">
                                        @vacante.Requisitos
                                    </div>
                                </td>

                                <td class="col-estado">
                                    @if (esActiva)
                                    {
                                        <span class="badge-estado badge-estado-activa">
                                            <span class="badge-dot"></span>
                                            @vacante.Estado
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-estado badge-estado-inactiva">
                                            <span class="badge-dot"></span>
                                            @vacante.Estado
                                        </span>
                                    }
                                </td>

                                <td class="col-fecha">
                                    <div class="fecha-info">
                                        <i class="fas fa-calendar-alt"></i>
                                        <span>@vacante.FechaCreacion.ToString("dd/MM/yyyy")</span>
                                    </div>
                                </td>

                                <td class="col-acciones">
                                    <div class="acciones-group">
                                        <a asp-action="Details"
                                           asp-route-idVacante="@vacante.IdVacante"
                                           class="btn-accion btn-accion-ver"
                                           title="Ver detalles">
                                            <i class="fas fa-eye"></i>
                                            <span>Ver</span>
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-idVacante="@vacante.IdVacante"
                                           class="btn-accion btn-accion-editar"
                                           title="Editar vacante">
                                            <i class="fas fa-edit"></i>
                                            <span>Editar</span>
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-idVacante="@vacante.IdVacante"
                                           class="btn-accion btn-accion-eliminar"
                                           title="Eliminar vacante">
                                            <i class="fas fa-trash-alt"></i>
                                            <span>Eliminar</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Footer de la tabla -->
        <div class="vacantes-footer">
            <div class="footer-info">
                <i class="fas fa-database"></i>
                <span>Mostrando <strong>@totalVacantes</strong> vacante(s)</span>
            </div>
            <div class="footer-legend">
                <span class="legend-item">
                    <span class="legend-dot legend-dot-activa"></span> Activa
                </span>
                <span class="legend-item">
                    <span class="legend-dot legend-dot-inactiva"></span> Inactiva
                </span>
            </div>
        </div>
    }

</div>