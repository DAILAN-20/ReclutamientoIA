@model IEnumerable<ReclutamientoIA.Models.Vacante>

@{
    ViewData["Title"] = "Vacantes";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/vacantes.css"
          asp-append-version="true" />
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Vacantes</h1>
        <p class="text-muted">Administración de puestos disponibles</p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Crear vacante
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Todavía no hay vacantes registradas.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Título</th>
                    <th>Descripción</th>
                    <th>Requisitos</th>
                    <th>Estado</th>
                    <th>Fecha de creación</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var vacante in Model)
                {
                    <tr>
                        <td>@vacante.Titulo</td>
                        <td>@vacante.Descripcion</td>
                        <td>@vacante.Requisitos</td>
                        <td>
                            @if (vacante.Estado == "Activa")
                            {
                                <span class="badge bg-success">Activa</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">
                                    @vacante.Estado
                                </span>
                            }
                        </td>
                        <td>@vacante.FechaCreacion.ToString("dd/MM/yyyy")</td>
                        <td class="text-center">
                            <a asp-action="SeleccionarCandidatos"
                               asp-route-idVacante="@vacante.IdVacante"
                               class="btn btn-primary btn-sm">
                                Analizar CV
                            </a>

                            <a asp-action="Edit"
                               asp-route-idVacante="@vacante.IdVacante"
                               class="btn btn-warning btn-sm">
                                Editar
                            </a>

                            <a asp-action="Details"
                               asp-route-idVacante="@vacante.IdVacante"
                               class="btn btn-info btn-sm">
                                Detalles
                            </a>

                            <a asp-action="Delete"
                               asp-route-idVacante="@vacante.IdVacante"
                               class="btn btn-danger btn-sm">
                                Eliminar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}