@model IEnumerable<ReclutamientoIA.Models.AnalisisIA>

@{
    ViewData["Title"] = "Ranking de Candidatos";
    var vacante = ViewBag.Vacante as ReclutamientoIA.Models.Vacante;
    var totalAnalizados = Model.Count();
    var puntuacionPromedio = totalAnalizados > 0 ? Math.Round(Model.Average(a => a.Puntuacion), 1) : 0;
    var mejorPuntuacion = totalAnalizados > 0 ? Model.Max(a => a.Puntuacion) : 0;
    var peorPuntuacion = totalAnalizados > 0 ? Model.Min(a => a.Puntuacion) : 0;
    var preseleccionados = Model.Count(a => a.EstadoProceso == "Preseleccionado");
    var aprobados = Model.Count(a => a.EstadoProceso == "Aprobado");
    var rechazados = Model.Count(a => a.EstadoProceso == "Rechazado");
}

@section Styles {
    <link rel="stylesheet" href="~/css/resultados.css" asp-append-version="true" />
}

<div class="resultados-page">

    <!-- ============================================
         HEADER
         ============================================ -->
    <div class="resultados-header">
        <div>
            <h1>
                <i class="fas fa-trophy"></i>
                Ranking de candidatos
            </h1>
            <p>
                <i class="fas fa-briefcase"></i>
                Vacante: <strong>@vacante?.Titulo</strong>
                <span class="sep">•</span>
                <i class="fas fa-users"></i>
                @totalAnalizados candidato(s)
                <span class="sep">•</span>
                <i class="fas fa-calendar"></i>
                @DateTime.Now.ToString("dd/MM/yyyy")
            </p>
        </div>

        <div class="resultados-header-actions">
            <a asp-action="CargaMasiva"
               asp-route-idVacante="@vacante?.IdVacante"
               class="btn-accion-header btn-primary">
                <i class="fas fa-plus-circle"></i>
                <span>Analizar CV</span>
            </a>
          
            <a asp-action="Index" class="btn-accion-header">
                <i class="fas fa-arrow-left"></i>
                <span>Volver</span>
            </a>
        </div>
    </div>

    <!-- ============================================
         ALERTAS
         ============================================ -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert-custom alert-success">
            <i class="fas fa-check-circle"></i>
            <span>@TempData["Mensaje"]</span>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert-custom alert-warning">
            <i class="fas fa-exclamation-triangle"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    <!-- ============================================
         SIN DATOS
         ============================================ -->
    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">
                <i class="fas fa-inbox"></i>
            </div>
            <h3 class="empty-title">No hay candidatos analizados</h3>
            <p class="empty-text">
                Esta vacante todavía no tiene candidatos analizados con IA.
            </p>
            <a asp-action="CargaMasiva"
               asp-route-idVacante="@vacante?.IdVacante"
               class="btn-accion-header btn-primary">
                <i class="fas fa-plus-circle"></i>
                <span>Analizar primeros CV</span>
            </a>
        </div>
    }
    else
    {
        <!-- ============================================
             MÉTRICAS
             ============================================ -->
        <div class="metricas">
            <div class="metrica-card metrica-promedio">
                <div class="metrica-info">
                    <span class="metrica-label">Promedio</span>
                    <span class="metrica-value">@puntuacionPromedio</span>
                </div>
                <div class="metrica-icono">
                    <i class="fas fa-chart-line"></i>
                </div>
            </div>

            <div class="metrica-card metrica-mejor">
                <div class="metrica-info">
                    <span class="metrica-label">Mejor</span>
                    <span class="metrica-value">@mejorPuntuacion</span>
                </div>
                <div class="metrica-icono">
                    <i class="fas fa-trophy"></i>
                </div>
            </div>

            <div class="metrica-card metrica-peor">
                <div class="metrica-info">
                    <span class="metrica-label">Menor</span>
                    <span class="metrica-value">@peorPuntuacion</span>
                </div>
                <div class="metrica-icono">
                    <i class="fas fa-chart-line fa-flip-vertical"></i>
                </div>
            </div>

            <div class="metrica-card metrica-preseleccionados">
                <div class="metrica-info">
                    <span class="metrica-label">Preseleccionados</span>
                    <span class="metrica-value">@preseleccionados</span>
                </div>
                <div class="metrica-icono">
                    <i class="fas fa-star"></i>
                </div>
            </div>

            <div class="metrica-card metrica-aprobados">
                <div class="metrica-info">
                    <span class="metrica-label">Aprobados</span>
                    <span class="metrica-value">@aprobados</span>
                </div>
                <div class="metrica-icono">
                    <i class="fas fa-check-circle"></i>
                </div>
            </div>

            <div class="metrica-card metrica-rechazados">
                <div class="metrica-info">
                    <span class="metrica-label">Rechazados</span>
                    <span class="metrica-value">@rechazados</span>
                </div>
                <div class="metrica-icono">
                    <i class="fas fa-times-circle"></i>
                </div>
            </div>
        </div>

        <!-- ============================================
             TABLA
             ============================================ -->
        <div class="resultados-table-wrapper">
            <div class="table-header">
                <div class="table-header-info">
                    <i class="fas fa-list"></i>
                    <span>Listado de candidatos analizados</span>
                </div>

                <div class="table-header-search">
                    <i class="fas fa-search"></i>
                    <input type="text"
                           id="searchRanking"
                           placeholder="Buscar candidato..." />
                </div>
            </div>

            <div class="table-responsive">
                <table class="resultados-table" id="rankingTable">
                    <thead>
                        <tr>
                            <th class="col-pos text-center">#</th>
                            <th class="col-candidato">Candidato</th>
                            <th class="col-correo">Correo</th>
                            <th class="col-telefono">Teléfono</th>
                            <th class="col-puntaje text-center">Puntuación</th>
                            <th class="col-recomendacion">Recomendación</th>
                            <th class="col-estado">Estado</th>
                            <th class="col-fecha">Fecha</th>
                            <th class="col-acciones text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var posicion = 1;
                        }

                        @foreach (var analisis in Model)
                        {
                            var clasePuntuacion = analisis.Puntuacion >= 80 ? "alta" :
                                                  analisis.Puntuacion >= 60 ? "media" :
                                                  analisis.Puntuacion >= 40 ? "baja" : "muy-baja";

                            var claseEstado = analisis.EstadoProceso switch
                            {
                                "Aprobado" => "estado-aprobado",
                                "Preseleccionado" => "estado-preseleccionado",
                                "Entrevista Programada" => "estado-entrevista",
                                "Rechazado" => "estado-rechazado",
                                _ => "estado-analizado"
                            };

                            var clasePosicion = posicion == 1 ? "top1" :
                                                posicion == 2 ? "top2" :
                                                posicion == 3 ? "top3" : "";

                            var inicial = (analisis.Candidato?.NombreCompleto ?? "?").Substring(0, 1).ToUpper();

                            <tr class="@(posicion == 1 ? "fila-top" : "")">
                                <!-- POSICIÓN -->
                                <td class="col-pos text-center">
                                    <span class="posicion-badge @clasePosicion">
                                        @posicion
                                    </span>
                                </td>

                                <!-- CANDIDATO -->
                                <td class="col-candidato">
                                    <div class="candidato-cell">
                                        <div class="candidato-avatar">
                                            @inicial
                                        </div>
                                        <strong class="candidato-nombre" title="@(analisis.Candidato?.NombreCompleto ?? "Nombre no disponible")">
                                            @(analisis.Candidato?.NombreCompleto ?? "Nombre no disponible")
                                        </strong>
                                    </div>
                                </td>

                                <!-- CORREO -->
                                <td class="col-correo">
                                    @if (!string.IsNullOrEmpty(analisis.Candidato?.Correo))
                                    {
                                        <a href="mailto:@analisis.Candidato.Correo" class="link-contacto">
                                            @analisis.Candidato.Correo
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-vacio">No disponible</span>
                                    }
                                </td>

                                <!-- TELÉFONO -->
                                <td class="col-telefono">
                                    @if (!string.IsNullOrEmpty(analisis.Candidato?.Telefono))
                                    {
                                        <span>@analisis.Candidato.Telefono</span>
                                    }
                                    else
                                    {
                                        <span class="text-vacio">No disponible</span>
                                    }
                                </td>

                                <!-- PUNTUACIÓN -->
                                <td class="col-puntaje text-center">
                                    <span class="badge-puntuacion @clasePuntuacion">
                                        @analisis.Puntuacion<span>/100</span>
                                    </span>
                                </td>

                                <!-- RECOMENDACIÓN -->
                                <td class="col-recomendacion">
                                    <div class="recomendacion-texto" title="@analisis.Recomendacion">
                                        @analisis.Recomendacion
                                    </div>
                                </td>

                                <!-- ESTADO -->
                                <td class="col-estado">
                                    <span class="badge-estado @claseEstado">
                                        @analisis.EstadoProceso
                                    </span>
                                </td>

                                <!-- FECHA -->
                                <td class="col-fecha">
                                    <div class="fecha-cell">
                                        <span>@analisis.FechaAnalisis.ToString("dd/MM/yyyy")</span>
                                        <small>@analisis.FechaAnalisis.ToString("HH:mm")</small>
                                    </div>
                                </td>

                                <!-- ACCIONES -->
                                <td class="col-acciones">
                                    <div class="acciones-cell">
                                        <a asp-action="DetalleAnalisis"
                                           asp-route-idAnalisis="@analisis.IdAnalisis"
                                           class="btn-tabla btn-tabla-ver"
                                           title="Ver detalle">
                                            <i class="fas fa-eye"></i>
                                            <span>Ver</span>
                                        </a>

                                        @if (analisis.EstadoProceso == "Analizado")
                                        {
                                            <form asp-action="Preseleccionar"
                                                  asp-route-idAnalisis="@analisis.IdAnalisis"
                                                  method="post">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="btn-tabla btn-tabla-preseleccionar"
                                                        title="Preseleccionar">
                                                    <i class="fas fa-star"></i>
                                                    <span>Preseleccionar</span>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>

                            posicion++;
                        }
                    </tbody>
                </table>
            </div>

            <div class="table-footer">
                <div class="footer-info">
                    <i class="fas fa-database"></i>
                    <span>Mostrando <strong>@totalAnalizados</strong> candidato(s)</span>
                </div>
                <span class="badge-mejor">
                    <i class="fas fa-arrow-up"></i>
                    Mejor puntuación: <strong>@mejorPuntuacion</strong>
                </span>
            </div>
        </div>
    }

</div>

@section Scripts {
    <script>
        // ============================================
        // BÚSQUEDA EN TIEMPO REAL
        // ============================================
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('searchRanking');
            const table = document.getElementById('rankingTable');

            if (!searchInput || !table) return;

            searchInput.addEventListener('keyup', function() {
                const filter = this.value.toLowerCase().trim();
                const rows = table.querySelectorAll('tbody tr');

                rows.forEach(row => {
                    const text = row.textContent.toLowerCase();
                    row.style.display = text.includes(filter) ? '' : 'none';
                });
            });
        });
    </script>
}