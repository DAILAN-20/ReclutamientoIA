@model IEnumerable<ReclutamientoIA.Models.AnalisisIA>

@{
    ViewData["Title"] = "Tablero de candidatos";

    var candidatos = Model.ToList();

    var vacantes = ViewBag.Vacantes
        as IEnumerable<ReclutamientoIA.Models.Vacante>
        ?? Enumerable.Empty<ReclutamientoIA.Models.Vacante>();

    int? idVacanteSeleccionada = ViewBag.IdVacante;

    var entrevistasPendientes = ViewBag.EntrevistasPendientes
        as Dictionary<int, ReclutamientoIA.Models.Entrevista>
        ?? new Dictionary<int, ReclutamientoIA.Models.Entrevista>();

    var estados = new[]
    {
        "Preseleccionado",
        "Entrevista Programada",
        "Aprobado",
        "Rechazado"
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/tablero.css" asp-append-version="true" />
}

<div class="tablero-page">

    <!-- ============================================
         HEADER
         ============================================ -->
    <div class="tablero-header">
        <div class="tablero-header-info">
            <div class="tablero-header-icon">
                <i class="fas fa-columns"></i>
            </div>
            <div>
                <h1 class="tablero-title">Tablero de candidatos</h1>
                <p class="tablero-subtitle">
                    Seguimiento visual del proceso de selección por etapa
                </p>
            </div>
        </div>

        <div class="tablero-header-actions">
            <a asp-controller="Vacantes" asp-action="Index" class="btn-tablero-outline">
                <i class="fas fa-arrow-left"></i>
                <span>Volver a vacantes</span>
            </a>
        </div>
    </div>

    <!-- ============================================
         ALERTAS
         ============================================ -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert-custom alert-custom-success">
            <i class="fas fa-check-circle"></i>
            <span>@TempData["Mensaje"]</span>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert-custom alert-custom-warning">
            <i class="fas fa-exclamation-triangle"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    <!-- ============================================
         FILTROS
         ============================================ -->
    <div class="tablero-filtros">
        <form asp-controller="Vacantes"
              asp-action="Tablero"
              method="get"
              class="tablero-filtros-form">

            <div class="tablero-field">
                <label for="idVacante" class="tablero-label">
                    <i class="fas fa-filter"></i>
                    Filtrar por vacante
                </label>

                <div class="tablero-select-wrapper">
                    <select id="idVacante" name="idVacante" class="tablero-select">
                        <option value="">Todas las vacantes</option>

                        @foreach (var vacante in vacantes)
                        {
                            if (idVacanteSeleccionada == vacante.IdVacante)
                            {
                                <option value="@vacante.IdVacante" selected>
                                    @vacante.Titulo
                                </option>
                            }
                            else
                            {
                                <option value="@vacante.IdVacante">
                                    @vacante.Titulo
                                </option>
                            }
                        }
                    </select>
                    <i class="fas fa-chevron-down tablero-select-chevron"></i>
                </div>
            </div>

            <div class="tablero-filtros-actions">
                <button type="submit" class="btn-tablero-primary">
                    <i class="fas fa-search"></i>
                    <span>Filtrar</span>
                </button>

                <a asp-controller="Vacantes" asp-action="Tablero" class="btn-tablero-outline">
                    <i class="fas fa-times"></i>
                    <span>Limpiar</span>
                </a>
            </div>
        </form>
    </div>

    <!-- ============================================
         INFO BAR
         ============================================ -->
    <div class="tablero-infobar">
        <div class="tablero-infobar-text">
            <i class="fas fa-info-circle"></i>
            <span>Los estados cambian al programar, cancelar o calificar una entrevista.</span>
        </div>

        <div class="tablero-infobar-total">
            <i class="fas fa-users"></i>
            <span>Total:</span>
            <strong>@candidatos.Count</strong>
        </div>
    </div>

    <!-- ============================================
         TABLERO KANBAN
         ============================================ -->
    <div class="tablero-kanban">
        @foreach (var estado in estados)
        {
            var candidatosEstado = candidatos
                .Where(a => a.EstadoProceso == estado)
                .ToList();

            var claseEstado = estado switch
            {
                "Preseleccionado" => "columna-preseleccionado",
                "Entrevista Programada" => "columna-entrevista",
                "Aprobado" => "columna-aprobado",
                "Rechazado" => "columna-rechazado",
                _ => "columna-default"
            };

            var iconoEstado = estado switch
            {
                "Preseleccionado" => "fa-star",
                "Entrevista Programada" => "fa-calendar-check",
                "Aprobado" => "fa-check-circle",
                "Rechazado" => "fa-times-circle",
                _ => "fa-circle"
            };

            <div class="tablero-columna @claseEstado">
                <!-- HEADER COLUMNA -->
                <div class="columna-header">
                    <div class="columna-header-left">
                        <i class="fas @iconoEstado"></i>
                        <h2 class="columna-title">@estado</h2>
                    </div>
                    <span class="columna-count">@candidatosEstado.Count</span>
                </div>

                <!-- BODY COLUMNA -->
                <div class="columna-body">
                    @if (!candidatosEstado.Any())
                    {
                        <div class="columna-empty">
                            <i class="fas fa-inbox"></i>
                            <p>No hay candidatos en esta etapa.</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var analisis in candidatosEstado)
                        {
                            var nombreInicial = (analisis.Candidato?.NombreCompleto ?? "?")
                                .Substring(0, 1).ToUpper();

                            <div class="candidato-card">
                                <!-- CABECERA: AVATAR + NOMBRE -->
                                <div class="candidato-card-header">
                                    <div class="candidato-card-avatar">
                                        @nombreInicial
                                    </div>
                                    <div class="candidato-card-info">
                                        <h3 class="candidato-card-nombre" title="@(analisis.Candidato?.NombreCompleto ?? "Nombre no disponible")">
                                            @(analisis.Candidato?.NombreCompleto ?? "Nombre no disponible")
                                        </h3>
                                        <p class="candidato-card-vacante" title="@analisis.Vacante?.Titulo">
                                            <i class="fas fa-briefcase"></i>
                                            @analisis.Vacante?.Titulo
                                        </p>
                                    </div>
                                </div>

                                <!-- PUNTAJE IA -->
                                <div class="candidato-card-puntaje">
                                    <div class="puntaje-label">
                                        <i class="fas fa-robot"></i>
                                        <span>Puntaje IA</span>
                                    </div>
                                    <div class="puntaje-badge @(analisis.Puntuacion >= 80 ? "puntaje-alto" : analisis.Puntuacion >= 60 ? "puntaje-medio" : "puntaje-bajo")">
                                        @analisis.Puntuacion<span>/100</span>
                                    </div>
                                </div>

                                <!-- INFO ENTREVISTA (solo si aplica) -->
                                @if (estado == "Entrevista Programada" &&
                                     entrevistasPendientes.TryGetValue(analisis.IdAnalisis, out var entrevista))
                                {
                                    <div class="entrevista-info">
                                        <div class="entrevista-info-item">
                                            <i class="fas fa-calendar"></i>
                                            <span>
                                                <strong>Fecha:</strong>
                                                @entrevista.FechaEntrevista.ToString("dd/MM/yyyy")
                                            </span>
                                        </div>
                                        <div class="entrevista-info-item">
                                            <i class="fas fa-clock"></i>
                                            <span>
                                                <strong>Hora:</strong>
                                                @(DateTime.Today.Add(entrevista.HoraEntrevista).ToString("hh:mm tt"))
                                            </span>
                                        </div>
                                        <div class="entrevista-info-item">
                                            <i class="fas fa-user-tie"></i>
                                            <span>
                                                <strong>Entrevistador:</strong>
                                                @entrevista.Entrevistador
                                            </span>
                                        </div>
                                    </div>
                                }

                                <!-- ACCIONES -->
                                <div class="candidato-card-actions">
                                    <a asp-controller="Vacantes"
                                       asp-action="DetalleAnalisis"
                                       asp-route-idAnalisis="@analisis.IdAnalisis"
                                       class="btn-card btn-card-outline">
                                        <i class="fas fa-eye"></i>
                                        <span>Ver detalle</span>
                                    </a>

                                    @if (estado == "Preseleccionado")
                                    {
                                        <a asp-controller="Entrevistas"
                                           asp-action="Agendar"
                                           asp-route-idAnalisis="@analisis.IdAnalisis"
                                           class="btn-card btn-card-primary">
                                            <i class="fas fa-calendar-plus"></i>
                                            <span>Programar entrevista</span>
                                        </a>
                                    }
                                    else if (estado == "Entrevista Programada")
                                    {
                                        if (entrevistasPendientes.TryGetValue(analisis.IdAnalisis, out var ent))
                                        {
                                            if (!string.IsNullOrWhiteSpace(ent.EnlaceEntrevista) &&
                                                Uri.TryCreate(ent.EnlaceEntrevista, UriKind.Absolute, out var enlace) &&
                                                (enlace.Scheme == Uri.UriSchemeHttps || enlace.Scheme == Uri.UriSchemeHttp))
                                            {
                                                <a href="@enlace.AbsoluteUri"
                                                   target="_blank"
                                                   rel="noopener noreferrer"
                                                   class="btn-card btn-card-success">
                                                    <i class="fas fa-video"></i>
                                                    <span>Abrir entrevista virtual</span>
                                                </a>
                                            }
                                        }

                                        <a asp-controller="Entrevistas"
                                           asp-action="Index"
                                           asp-route-idAnalisis="@analisis.IdAnalisis"
                                           class="btn-card btn-card-outline">
                                            <i class="fas fa-clipboard-list"></i>
                                            <span>Ver entrevista</span>
                                        </a>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>

</div>