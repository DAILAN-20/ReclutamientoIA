@model ReclutamientoIA.Models.CargaMasivaCurriculumsViewModel

@{
    ViewData["Title"] = "Analizar currículums";
}

@section Styles {
    <link rel="stylesheet" href="~/css/carga-masiva.css" asp-append-version="true" />
}

<div class="carga-masiva-page">

    <!-- ============================================
         HEADER
         ============================================ -->
    <div class="carga-header">
        <div class="carga-header-info">
            <div class="carga-header-icon">
                <i class="fas fa-robot"></i>
            </div>
            <div>
                <h1 class="carga-title">
                    Análisis de Currículums con IA
                </h1>
                <p class="carga-subtitle">
                    Selecciona una vacante y carga hasta 20 currículums en formato PDF
                    para su análisis automático con inteligencia artificial.
                </p>
            </div>
        </div>

        <div class="carga-header-steps">
            <div class="step-item">
                <span class="step-number">1</span>
                <span class="step-text">Seleccionar vacante</span>
            </div>
            <i class="fas fa-arrow-right step-arrow"></i>
            <div class="step-item">
                <span class="step-number">2</span>
                <span class="step-text">Cargar CVs</span>
            </div>
            <i class="fas fa-arrow-right step-arrow"></i>
            <div class="step-item">
                <span class="step-number">3</span>
                <span class="step-text">Analizar</span>
            </div>
        </div>
    </div>

    <!-- ============================================
         FORMULARIO
         ============================================ -->
    <div class="carga-form-container">
        <form asp-action="CargaMasiva"
              method="post"
              enctype="multipart/form-data"
              id="formCargaMasiva">

            <!-- VALIDACIÓN -->
            <div asp-validation-summary="ModelOnly"
                 class="carga-alert carga-alert-danger">
            </div>

            <!-- PASO 1: VACANTE -->
            <div class="carga-section">
                <div class="carga-section-header">
                    <div class="carga-section-badge">Paso 1</div>
                    <div>
                        <h3 class="carga-section-title">
                            <i class="fas fa-briefcase"></i>
                            Seleccionar Vacante
                        </h3>
                        <p class="carga-section-desc">
                            Elige la vacante para la cual deseas analizar los currículums.
                        </p>
                    </div>
                </div>

                <div class="carga-field">
                    <label asp-for="IdVacante" class="carga-label">
                        Vacante disponible
                    </label>

                    <div class="carga-select-wrapper">
                        <i class="fas fa-briefcase carga-select-icon"></i>
                        <select asp-for="IdVacante"
                                asp-items="ViewBag.Vacantes"
                                class="carga-select"
                                id="selectVacante">
                            <option value="">— Selecciona una vacante —</option>
                        </select>
                        <i class="fas fa-chevron-down carga-select-chevron"></i>
                    </div>

                    <span asp-validation-for="IdVacante" class="carga-error"></span>
                </div>
            </div>

            <!-- PASO 2: ARCHIVOS -->
            <div class="carga-section">
                <div class="carga-section-header">
                    <div class="carga-section-badge">Paso 2</div>
                    <div>
                        <h3 class="carga-section-title">
                            <i class="fas fa-file-upload"></i>
                            Cargar Currículums
                        </h3>
                        <p class="carga-section-desc">
                            Sube hasta 20 archivos PDF. Cada uno puede pesar máximo 10 MB.
                        </p>
                    </div>
                </div>

                <div class="carga-field">
                    <label asp-for="Archivos" class="carga-label">
                        Currículums (PDF)
                    </label>

                    <!-- DROPZONE -->
                    <div class="upload-dropzone" id="dropzone">
                        <input asp-for="Archivos"
                               type="file"
                               accept=".pdf,application/pdf"
                               multiple
                               class="upload-input"
                               id="archivosCv" />

                        <div class="upload-dropzone-content" id="dropzoneContent">
                            <div class="upload-icon">
                                <i class="fas fa-cloud-upload-alt"></i>
                            </div>
                            <h4 class="upload-title">
                                Arrastra tus archivos aquí
                            </h4>
                            <p class="upload-subtitle">
                                o
                                <label for="archivosCv" class="upload-browse">
                                    selecciona archivos
                                </label>
                                desde tu dispositivo
                            </p>
                            <div class="upload-info">
                                <span>
                                    <i class="fas fa-file-pdf"></i>
                                    PDF
                                </span>
                                <span>
                                    <i class="fas fa-weight-hanging"></i>
                                    Máx. 10 MB por archivo
                                </span>
                                <span>
                                    <i class="fas fa-layer-group"></i>
                                    Hasta 20 archivos
                                </span>
                            </div>
                        </div>
                    </div>

                    <span asp-validation-for="Archivos" class="carga-error"></span>
                </div>
            </div>

            <!-- RESUMEN DE ARCHIVOS -->
            <div id="resumenArchivos" class="carga-summary d-none">
                <div class="carga-summary-header">
                    <div class="carga-summary-title">
                        <i class="fas fa-check-circle"></i>
                        <strong id="cantidadArchivos">0 archivos seleccionados</strong>
                    </div>
                    <button type="button"
                            class="btn-limpiar-archivos"
                            id="btnLimpiarArchivos">
                        <i class="fas fa-times"></i>
                        Limpiar
                    </button>
                </div>

                <ul id="listaArchivos" class="carga-summary-list"></ul>
            </div>

            <!-- AVISO PROCESANDO -->
            <div id="avisoProcesando" class="carga-processing d-none">
                <div class="carga-processing-content">
                    <div class="carga-spinner"></div>
                    <div>
                        <strong>Analizando currículums con IA...</strong>
                        <p>No cierres ni actualices esta página. El proceso puede tomar varios minutos.</p>
                    </div>
                </div>
                <div class="carga-progress-bar">
                    <div class="carga-progress-fill"></div>
                </div>
            </div>

            <!-- PASO 3: ACCIONES -->
            <div class="carga-actions">
                <button type="submit"
                        class="btn-carga-primary"
                        id="botonAnalizar">
                    <i class="fas fa-magic"></i>
                    <span>Analizar currículums</span>
                </button>

                <a asp-action="Index" class="btn-carga-secondary">
                    <i class="fas fa-arrow-left"></i>
                    <span>Volver a vacantes</span>
                </a>
            </div>
        </form>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        (() => {
            const input = document.getElementById("archivosCv");
            const resumen = document.getElementById("resumenArchivos");
            const cantidad = document.getElementById("cantidadArchivos");
            const lista = document.getElementById("listaArchivos");
            const formulario = document.getElementById("formCargaMasiva");
            const boton = document.getElementById("botonAnalizar");
            const aviso = document.getElementById("avisoProcesando");
            const dropzone = document.getElementById("dropzone");
            const dropzoneContent = document.getElementById("dropzoneContent");
            const btnLimpiar = document.getElementById("btnLimpiarArchivos");
            const selectVacante = document.getElementById("selectVacante");

            const MAX_ARCHIVOS = 20;
            const MAX_TAMANO_MB = 10;
            const MAX_TAMANO_BYTES = MAX_TAMANO_MB * 1024 * 1024;

            // ============================================
            // FORMATEAR TAMAÑO DE ARCHIVO
            // ============================================
            function formatearTamano(bytes) {
                if (bytes < 1024) return bytes + " B";
                if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + " KB";
                return (bytes / (1024 * 1024)).toFixed(2) + " MB";
            }

            // ============================================
            // RENDERIZAR LISTA DE ARCHIVOS
            // ============================================
            function renderizarArchivos(archivos) {
                lista.innerHTML = "";

                if (archivos.length === 0) {
                    resumen.classList.add("d-none");
                    return;
                }

                resumen.classList.remove("d-none");

                cantidad.textContent = archivos.length === 1
                    ? "1 currículum seleccionado"
                    : archivos.length + " currículums seleccionados";

                archivos.forEach((archivo, index) => {
                    const li = document.createElement("li");
                    li.className = "carga-summary-item";

                    const esValido = archivo.name.toLowerCase().endsWith(".pdf")
                                     && archivo.size <= MAX_TAMANO_BYTES;

                    li.innerHTML = `
                        <div class="item-icon ${esValido ? '' : 'item-icon-error'}">
                            <i class="fas ${esValido ? 'fa-file-pdf' : 'fa-exclamation-triangle'}"></i>
                        </div>
                        <div class="item-info">
                            <span class="item-name">${archivo.name}</span>
                            <span class="item-size">${formatearTamano(archivo.size)}</span>
                        </div>
                        ${!esValido ? '<span class="item-badge">Inválido</span>' : '<span class="item-badge item-badge-ok"><i class="fas fa-check"></i></span>'}
                    `;

                    lista.appendChild(li);
                });
            }

            // ============================================
            // EVENTO CHANGE EN INPUT
            // ============================================
            input.addEventListener("change", () => {
                let archivos = Array.from(input.files);

                // Validar máximo de archivos
                if (archivos.length > MAX_ARCHIVOS) {
                    alert(`Solo puedes seleccionar hasta ${MAX_ARCHIVOS} archivos.`);
                    archivos = archivos.slice(0, MAX_ARCHIVOS);
                }

                renderizarArchivos(archivos);
            });

            // ============================================
            // DRAG & DROP
            // ============================================
            ["dragenter", "dragover"].forEach(evento => {
                dropzone.addEventListener(evento, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.classList.add("dropzone-hover");
                });
            });

            ["dragleave", "drop"].forEach(evento => {
                dropzone.addEventListener(evento, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropzone.classList.remove("dropzone-hover");
                });
            });

            dropzone.addEventListener("drop", (e) => {
                const archivos = e.dataTransfer.files;
                if (archivos.length > 0) {
                    input.files = archivos;
                    input.dispatchEvent(new Event("change"));
                }
            });

            // ============================================
            // LIMPIAR ARCHIVOS
            // ============================================
            btnLimpiar.addEventListener("click", () => {
                input.value = "";
                lista.innerHTML = "";
                resumen.classList.add("d-none");
            });

            // ============================================
            // SUBMIT DEL FORMULARIO
            // ============================================
            formulario.addEventListener("submit", (e) => {
                if (!formulario.checkValidity()) {
                    return;
                }

                if (!input.files || input.files.length === 0) {
                    e.preventDefault();
                    alert("Debes seleccionar al menos un currículum.");
                    return;
                }

                boton.disabled = true;
                boton.innerHTML = '<i class="fas fa-spinner fa-spin"></i><span>Analizando...</span>';
                aviso.classList.remove("d-none");
                aviso.scrollIntoView({ behavior: "smooth", block: "center" });

                // Deshabilitar interacciones
                selectVacante.disabled = true;
                input.disabled = true;
                btnLimpiar.disabled = true;
            });

        })();
    </script>
}