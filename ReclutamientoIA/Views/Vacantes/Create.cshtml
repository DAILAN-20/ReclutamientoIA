@model ReclutamientoIA.Models.Vacante

@{
    ViewData["Title"] = "Crear vacante";
}
@section Styles {
    <link rel="stylesheet"
          href="~/css/vacantes.css"
          asp-append-version="true" />
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h4 class="mb-0">Crear nueva vacante</h4>
            </div>

            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Titulo" class="form-label">
                            Título de la vacante
                        </label>
                        <input asp-for="Titulo"
                               class="form-control"
                               placeholder="Ejemplo: Desarrollador de software" />
                        <span asp-validation-for="Titulo"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label">
                            Descripción
                        </label>
                        <textarea asp-for="Descripcion"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Describa las funciones del puesto"></textarea>
                        <span asp-validation-for="Descripcion"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Requisitos" class="form-label">
                            Requisitos
                        </label>
                        <textarea asp-for="Requisitos"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Experiencia, estudios y conocimientos requeridos"></textarea>
                        <span asp-validation-for="Requisitos"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Estado" class="form-label">
                            Estado
                        </label>
                        <select asp-for="Estado" class="form-select">
                            <option value="Activa">Activa</option>
                            <option value="Inactiva">Inactiva</option>
                        </select>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            Guardar vacante
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Volver
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}