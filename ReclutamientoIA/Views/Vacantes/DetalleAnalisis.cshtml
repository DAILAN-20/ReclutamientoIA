@model ReclutamientoIA.Models.AnalisisIA

@{
    ViewData["Title"] = "Detalle del análisis";

    var clasePuntuacion = Model.Puntuacion >= 80 ? "alta" :
                          Model.Puntuacion >= 60 ? "media" : "baja";

    var claseEstado = Model.EstadoProceso switch
    {
        "Preseleccionado" => "estado-preseleccionado",
        "Entrevista Programada" => "estado-entrevista",
        "Aprobado" => "estado-aprobado",
        "Rechazado" => "estado-rechazado",
        _ => "estado-analizado"
    };

    var inicial = string.IsNullOrWhiteSpace(Model.Candidato?.NombreCompleto)
        ? "C"
        : Model.Candidato.NombreCompleto.Substring(0, 1).ToUpper();
}

@section Styles {
    <link rel="stylesheet" href="~/css/detalle-analisis.css" asp-append-version="true" />
}

<div class="detalle-page">

    <!-- HEADER -->
    <div class="detalle-header">
        <div>
            <h1>Detalle del análisis</h1>
            <p>
                <i class="fas fa-briefcase"></i>
                Vacante: <strong>@Model.Vacante.Titulo</strong>
            </p>
        </div>

        <a asp-action="Resultados"
           asp-route-idVacante="@Model.IdVacante"
           class="btn-detalle-outline">
            <i class="fas fa-arrow-left"></i>
            <span>Volver al ranking</span>
        </a>
    </div>

    <!-- ALERTAS -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert-custom alert-success">
            <i class="fas fa-check-circle"></i>
            <span>@TempData["Mensaje"]</span>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert-custom alert-warning">
            <i class="fas fa-exclamation-triangle"></i>
            <span>@TempData["Error"]</span>
        </div>
    }

    <!-- BARRA DE ACCIÓN SEGÚN ESTADO -->
    @if (Model.EstadoProceso == "Analizado")
    {
        <div class="barra-accion barra-analizado">
            <div class="barra-info">
                <i class="fas fa-info-circle"></i>
                <span>Candidato analizado y listo para preselección.</span>
            </div>
            <form asp-action="Preseleccionar" method="post">
                <input type="hidden" name="idAnalisis" value="@Model.IdAnalisis" />
                <button type="submit" class="btn-detalle-primary btn-success">
                    <i class="fas fa-star"></i>
                    <span>Preseleccionar</span>
                </button>
            </form>
        </div>
    }
    else if (Model.EstadoProceso == "Preseleccionado")
    {
        <div class="barra-accion barra-preseleccionado">
            <div class="barra-info">
                <i class="fas fa-check-circle"></i>
                <span>Candidato preseleccionado, listo para entrevista.</span>
            </div>
            <a asp-controller="Entrevistas"
               asp-action="Agendar"
               asp-route-idAnalisis="@Model.IdAnalisis"
               41c0l00a20s514560000021s="btn-detalle-primary btn-cyan">
                <i class="fas fa-calendar-plus"></i>
                <span>Programar entrevista</span>
            </a>
        </div>
    }
    else if (Model.EstadoProceso == "Entrevista Programada")
    {
        <div class="barra-accion barra-entrevista">
            <div class="barra-info">
                <i class="fas fa-calendar-check"></i>
                <span>Este candidato ya tiene una entrevista programada.</span>
            </div>
            <a asp-controller="Entrevistas"
               asp-action="Index"
               class="btn-detalle-primary btn-cyan">
                <i class="fas fa-list"></i>
                <span>Ver entrevistas</span>
            </a>
        </div>
    }

    <!-- GRID PRINCIPAL -->
    <div class="detalle-grid">

        <!-- SIDEBAR -->
        <aside class="detalle-sidebar">

            <div class="detalle-card">
                <div class="candidato-header">
                    <div class="candidato-avatar">@inicial</div> 
                    <h2>@(Model.Candidato.NombreCompleto ?? "Nombre no disponible")</h2>
                    <span class="badge-estado @claseEstado">
                        @Model.EstadoProceso
                    </span>
                </div>

                <div class="candidato-body">

                    <div class="puntaje-caja puntaje-@clasePuntuacion">
                        <span class="puntaje-label">Puntaje IA</span>
                        <span class="puntaje-valor">@Model.Puntuacion<span>/100</span></span>
                    </div>

                    <ul class="info-lista">
                        <li>
                            <i class="fas fa-envelope"></i>
                            <div>
                                <span>Correo</span>
                                <strong>@(Model.Candidato.Correo ?? "No disponible")</strong>
                            </div>
                        </li>
                        <li>
                            <i class="fas fa-phone"></i>
                            <div>
                                <span>Teléfono</span>
                                <strong>@(Model.Candidato.Telefono ?? "No disponible")</strong>
                            </div>
                        </li>
                        <li>
                            <i class="fas fa-microchip"></i>
                            <div>
                                <span>Motor IA</span>
                                <strong>@Model.ProveedorIA · @Model.ModeloIA</strong>
                            </div>
                        </li>
                        <li>
                            <i class="fas fa-calendar-alt"></i>
                            <div>
                                <span>Fecha</span>
                                <strong>@Model.FechaAnalisis.ToString("dd/MM/yyyy hh:mm tt")</strong>
                            </div>
                        </li>
                    </ul>

                    <div class="cv-actions">
                        <a asp-controller="Candidatos"
                           asp-action="VerCurriculum"
                           asp-route-id="@Model.IdCandidato"
                           target="_blank"
                           class="btn-cv btn-cv-ver">
                            <i class="fas fa-eye"></i>
                            <span>Ver CV</span>
                        </a>
                        <a asp-controller="Candidatos"
                           asp-action="Descargar"
                           asp-route-id="@Model.IdCandidato"
                           class="btn-cv btn-cv-descargar">
                            <i class="fas fa-download"></i>
                            <span>Descargar</span>
                        </a>
                    </div>

                </div>
            </div>

        </aside>

        <!-- CONTENIDO -->
        <div class="detalle-contenido">

            <div class="detalle-card">
                <div class="seccion-header">
                    <i class="fas fa-align-left"></i>
                    <h3>Resumen</h3>
                </div>
                <div class="seccion-body">
                    @(string.IsNullOrWhiteSpace(Model.Resumen)
                        ? "No hay resumen disponible."
                        : Model.Resumen)
                </div>
            </div>

            <div class="detalle-card">
                <div class="seccion-header">
                    <i class="fas fa-thumbs-up"></i>
                    <h3>Fortalezas</h3>
                </div>
                <div class="seccion-body">
                    @(string.IsNullOrWhiteSpace(Model.Fortalezas)
                        ? "No hay fortalezas registradas."
                        : Model.Fortalezas)
                </div>
            </div>

            <div class="detalle-card">
                <div class="seccion-header">
                    <i class="fas fa-exclamation-triangle"></i>
                    <h3>Debilidades</h3>
                </div>
                <div class="seccion-body">
                    @(string.IsNullOrWhiteSpace(Model.Debilidades)
                        ? "No hay debilidades registradas."
                        : Model.Debilidades)
                </div>
            </div>

            <div class="detalle-card">
                <div class="seccion-header">
                    <i class="fas fa-lightbulb"></i>
                    <h3>Recomendación</h3>
                </div>
                <div class="seccion-body">
                    @(string.IsNullOrWhiteSpace(Model.Recomendacion)
                        ? "No hay recomendación registrada."
                        : Model.Recomendacion)
                </div>
            </div>

        </div>

    </div>

</div>